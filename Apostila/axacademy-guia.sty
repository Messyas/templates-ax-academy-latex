% --- Moldura das paginas de arte ---------------------------------------------
% Capa, folha de rosto, contracapa e placas de parte sao desenhadas num
% tikzpicture do tamanho exato da folha A4, com origem no canto superior
% esquerdo e o eixo y crescendo para BAIXO, como as medidas de uma arte.
% Sem `remember picture', de proposito: assim sai certo ja na primeira
% passada, inclusive a contracapa, que e a ultima pagina.
\def\guiaWfolha{595.276}
\def\guiaHfolha{841.89}

\newcommand{\guiafolha}[1]{%
    \thispagestyle{empty}%
    \newgeometry{margin=0pt}%
    \noindent\begin{tikzpicture}[x=1bp,y=-1bp,inner sep=0pt,outer sep=0pt]
        \useasboundingbox (0,0) rectangle (\guiaWfolha,\guiaHfolha);
        #1
    \end{tikzpicture}%
    \clearpage
    \restoregeometry
    \color{guiatinta}%
}

% --- Camada de fundo ----------------------------------------------------------
% O papel, as duas manchas de paralelogramos em cantos opostos -- a de cima
% so de contorno (padrao-claro.pdf), a de baixo com realces (padrao.pdf) -- e
% a faixa vertical (art/fundo/faixa.pdf). O argumento diz de que
% lado fica a faixa: `direita' na capa e nas partes, `esquerda' na contracapa.
\newcommand{\guiafundo}[1]{%
    \begin{scope}
        \clip (0,0) rectangle (\guiaWfolha,\guiaHfolha);
        \fill[guiapapel] (0,0) rectangle (\guiaWfolha,\guiaHfolha);
        % no alto, atras do titulo, a versao so de contorno
        \node[anchor=north east] at (270,-170) {\includegraphics[width=600bp]{padrao-claro}};
        \node[anchor=north west] at (250,505) {\includegraphics[width=600bp]{padrao}};
        \ifstrequal{#1}{esquerda}{%
            \node[anchor=north west] at (0,0)
                {\reflectbox{\includegraphics[width=16bp,height=\paperheight]{faixa}}};
        }{%
            \node[anchor=north east] at (\guiaWfolha,0)
                {\includegraphics[width=16bp,height=\paperheight]{faixa}};
        }%
    \end{scope}%
}

% --- Caixa de aviso da capa ---------------------------------------------------
% Moldura de 160 x 73 pt com o selo de 40 pt encostado na borda de cima.
% O `anchor=center' e explicito em cada no: a caixa e desenhada DENTRO de um
% no da pagina, e um tikzpicture aninhado herda as opcoes do no que o contem.
\newcommand{\guiacaixaaviso}[2][160]{%
    \begin{tikzpicture}[x=1bp,y=1bp]
        \draw[draw=guiarosaborda,line width=0.75pt,rounded corners=8.5pt,
              fill=white] (0,0) rectangle (#1,-73);
        \node[anchor=center,inner sep=0pt,align=center,
              text width=\dimexpr#1pt-22pt\relax,
              font=\guiahead\fontsize{10.5}{14.5}\selectfont\color{guiatinta}]
              at (0.5*#1,-42) {#2};
        \node[anchor=center,circle,fill=guiarosa,minimum size=40pt,inner sep=0pt]
              at (0.5*#1,8) (bd) {};
        \node[anchor=center,inner sep=0pt] at (bd)
              {\fontsize{14}{14}\selectfont\color{guiavermelho}\faBookOpen};
    \end{tikzpicture}%
}

% =============================================================================
%  CABECALHO E RODAPE
%  O rodape e composto: marca do sistema, filete e duas linhas de credito. A
%  posicao do filete acompanha a largura da marca, que muda com o nome.
% =============================================================================
\newlength{\guiarodapefolga}\setlength{\guiarodapefolga}{16pt}

\newcommand{\guiarodape}{%
    \begin{tikzpicture}[baseline=0pt]
        \node[anchor=south west,inner sep=0pt,rounded corners=4pt,fill=guiapapel,
              minimum height=33pt,
              minimum width=\dimexpr\textwidth+\guiarodapefolga\relax] (bg) at (0,0) {};
        \node[anchor=west,inner sep=0pt] (mk) at ([xshift=10pt]bg.west)
            {\guiamarca{17pt}};
        \draw[guiaborda,line width=0.8pt]
            ([xshift=11pt,yshift=9pt]mk.east) -- ([xshift=11pt,yshift=-9pt]mk.east);
        \node[anchor=west,inner sep=0pt,align=left,
              font=\fontsize{8}{10.5}\selectfont\color{guiacinza}]
            at ([xshift=22pt]mk.east)
            % O titulo traz \\ para a capa; aqui ele vira espaco. Um \\ dentro
            % de grupo, num no de varias linhas do TikZ, derruba a compilacao
            % com "Giving up on this path". O nome do sistema nao se repete:
            % a marca, ao lado, ja o traz; versao e equipe ficam fora do rodape.
            {{\def\\{ }\color{guiatinta}\guiavaltitulo}\\
             AX Academy --- Digital Transformation \textperiodcentered\
             Instituto Federal do Amazonas};
    \end{tikzpicture}%
}

