% =============================================================================
%  CAIXA DE OBSERVACAO -- `remark'
%  Barra vertical a esquerda, fundo claro e um icone no recuo. O tipo escolhe
%  icone e cor:
%      \begin{remark} ... \end{remark}          atencao (padrao)
%      \begin{remark}[dica] ... \end{remark}    dica
%      \begin{remark}[info] ... \end{remark}    informacao
%      \begin{perigo} ... \end{perigo}          risco de perder dado ou acesso
% =============================================================================
\tcbuselibrary{skins,breakable}
\newcommand{\guiaicone@atencao}{\faExclamationTriangle}
\newcommand{\guiaicone@dica}{\faLightbulb}
\newcommand{\guiaicone@info}{\faInfoCircle}
\newcommand{\guiaicone@perigo}{\faExclamationCircle}
\newcommand{\guiacor@atencao}{guiaambar}
\newcommand{\guiacor@dica}{guiaverde}
\newcommand{\guiacor@info}{guiacinza}
\newcommand{\guiacor@perigo}{guiavermelho}

\newtcolorbox{guiaobs}[1][atencao]{%
    enhanced,breakable,
    colback=\csname guiacor@#1\endcsname!7,colframe=\csname guiacor@#1\endcsname,
    boxrule=0pt,leftrule=3.5bp,arc=0pt,
    left=32pt,right=12pt,top=8pt,bottom=8pt,
    fontupper=\small,
    overlay unbroken and first={%
        \node[anchor=north west,inner sep=0pt,
