% ---------- FONTE ----------
% LG EI, a mesma das apostilas e dos outros modelos: Headline nos titulos e na
% arte, Text no corpo. A familia nao tem italico; o AutoFakeSlant inclina a
% letra reta.
%
% Se fonts/ nao vier junto, cai para o nome instalado no sistema e avisa no
% log. O resultado diverge do modelo, sem erro nenhum.
\defaultfontfeatures{Ligatures=TeX}
\IfFileExists{../fonts/LGEITextTTF-Regular.ttf}{%
  \setmainfont{LGEITextTTF-Regular}[
      Path=../fonts/, Extension=.ttf,
      BoldFont=LGEITextTTF-SemiBold, AutoFakeSlant=0.18]
  \newfontfamily\guiahead{LGEIHeadlineTTF-Regular}[
      Path=../fonts/, Extension=.ttf,
      BoldFont=LGEIHeadlineTTF-Bold, AutoFakeSlant=0.18]
  \newfontfamily\guialight{LGEIHeadlineTTF-Light}[Path=../fonts/, Extension=.ttf]
  \newfontfamily\guiamedium{LGEIHeadlineTTF-Semibold}[Path=../fonts/, Extension=.ttf]
}{%
  \IfFileExists{fonts/LGEITextTTF-Regular.ttf}{%
    \setmainfont{LGEITextTTF-Regular}[
        Path=fonts/, Extension=.ttf,
        BoldFont=LGEITextTTF-SemiBold, AutoFakeSlant=0.18]
    \newfontfamily\guiahead{LGEIHeadlineTTF-Regular}[
        Path=fonts/, Extension=.ttf,
        BoldFont=LGEIHeadlineTTF-Bold, AutoFakeSlant=0.18]
    \newfontfamily\guialight{LGEIHeadlineTTF-Light}[Path=fonts/, Extension=.ttf]
    \newfontfamily\guiamedium{LGEIHeadlineTTF-Semibold}[Path=fonts/, Extension=.ttf]
  }{%
    \PackageWarning{axacademy-guia}{Pasta de fontes nao encontrada (procurado em ../fonts/ e fonts/); usando a
      fonte instalada no sistema. O resultado pode divergir do modelo.}%
    \setmainfont{LG EI Text}[BoldFont=* SemiBold, AutoFakeSlant=0.18]
    \newfontfamily\guiahead{LG EI Headline}[BoldFont=* Bold, AutoFakeSlant=0.18]
    \newfontfamily\guialight{LG EI Headline Light}
    \newfontfamily\guiamedium{LG EI Headline Semibold}
  }%
}
% Monoespacada: Latin Modern Mono, que vem em toda distribuicao TeX. A
% ligadura do TeX fica DESLIGADA (-tlig): com ela, os dois hifens de
% `--opcao' viram um travessao e o comando impresso deixa de ser o que se
% digita.
\setmonofont{lmmono10-regular}[
    Extension=.otf, BoldFont=lmmonolt10-bold,
    ItalicFont=lmmono10-italic, BoldItalicFont=lmmonolt10-boldoblique,
    RawFeature={-tlig}]

