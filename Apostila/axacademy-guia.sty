    itemsep=0.1em,topsep=0.2em,parsep=0pt}

% =============================================================================
%  PASSO -- pagina de duas colunas
%  Cada \passo e uma linha: a TELA a esquerda, so a imagem, e o TEXTO a
%  direita, com o selo do passo, o titulo e a explicacao. As linhas se
%  empilham e a pagina quebra entre elas, nunca dentro de uma.
%
%  Uso:
%      \passo[x1/y1, x2/y2, ...]{arquivo}{Titulo do passo}{%
%          Texto do passo.
%          \begin{elementos}
%              \item o que o marcador 1 indica;
%              \item o que o marcador 2 indica.
%          \end{elementos}
%      }
%
%  Os marcadores sao opcionais. Cada par x/y e a posicao na tela em FRACAO da
%  largura e da altura, com origem no canto SUPERIOR esquerdo: 0.5/0.5 e o
%  centro, 0.9/0.1 e o canto de cima a direita. A numeracao segue a ordem da
%  lista e casa com a lista `elementos'.
%
%  Cada passo recebe o rotulo passo:N, para \pageref{passo:3}, e entra no
%  sumario e no mapa da parte como secao numerada do capitulo.
% =============================================================================
\newcounter{guiapasso}
\newlength{\guiacolimagem}
\newlength{\guiacoltexto}
% Fracao da largura do texto que fica com a tela. 0,49 serve a telas de
% computador (16:10); para telas de celular, em pe, use \guiacolunas{0.36}.
\newcommand{\guiacolunas}[1]{%
    \setlength{\guiacolimagem}{#1\textwidth}%
    \setlength{\guiacoltexto}{\dimexpr\textwidth-\guiacolimagem-0.06\textwidth\relax}%
}
\guiacolunas{0.49}

\newcommand{\guiatela}[2]{%
    \begin{tikzpicture}
        \node[anchor=south west,inner sep=0pt] (tela) at (0,0)
            {\includegraphics[width=\guiacolimagem]{#2}};
        % Moldura e marcadores em `overlay': nao entram na medida da figura,
        % que fica exatamente com a largura da coluna. Um marcador na borda da
        % tela invade um pouco o vao entre as colunas, e e isso que se quer.
        \draw[overlay,guiaborda,line width=0.7pt] (tela.south west) rectangle (tela.north east);
        \ifblank{#1}{}{%
            \begin{scope}[overlay,x={(tela.south east)},y={(tela.north west)}]
                \foreach \mx/\my [count=\mn] in {#1}{%
                    \node[guia marcador] at (\mx,{1-\my}) {\mn};
                }
            \end{scope}%
        }%
    \end{tikzpicture}%
}

\NewDocumentCommand{\passo}{O{} m m +m}{%
    \par\addvspace{6pt}%
    % Cada passo conta como secao do capitulo: no sumario e no mapa da parte
    % sai numerado como as demais secoes (3.1, 3.2...), e a \section seguinte
    % continua a contagem. O numero do passo (1 a N, corrido no guia) fica so
    % no selo PASSO N, no BPMN e no mapa dos passos.
    \stepcounter{section}%
    \refstepcounter{guiapasso}\label{passo:\theguiapasso}%
    \addcontentsline{toc}{section}{\protect\numberline{\thesection}#3}%
    \noindent
    \begin{minipage}[t]{\guiacolimagem}\vspace{0pt}%
        \guiatela{#1}{#2}%
    \end{minipage}\hfill
    {\color{guiaborda}\vrule width 0.7pt}\hfill
    \begin{minipage}[t]{\guiacoltexto}\vspace{0pt}%
        \setlength{\parskip}{0.4em}%
        % Alinhado a esquerda: justificado, a coluna estreita abria vaos
        % grandes entre as palavras e partia muita palavra no fim da linha.
        \raggedright
        \fontsize{9.3}{12.6}\selectfont
        {\guiahead\bfseries\fontsize{8}{8}\selectfont
         \colorbox{guiavermelho}{\color{white}\strut PASSO \theguiapasso}}\par
        \vspace{0.1em}%
        {\guiahead\bfseries\fontsize{13.5}{16.5}\selectfont\color{guiatinta}#3\par}%
        #4\par
    \end{minipage}\par
    \vspace{10pt}%
    {\color{guiaborda}\hrule height 0.4pt}%
    \vspace{12pt}%
}

% =============================================================================
%  BPMN
%  Estilos para o fluxo de uso. Raias em COLUNA (o fluxo desce), para o
%  diagrama caber em pe na largura do texto. Cada tarefa que e um passo do
%  guia leva o marcador do passo no canto, com link para a pagina dele.
%
%      \bpmnraia{x0}{largura}{altura}{Rotulo}        raia, com o topo em y = 0
%      \node[bpmn inicio] (ini) at (x,y) {};         evento de inicio
%      \node[bpmn fim]    (fim) at (x,y) {};         evento de fim
%      \node[bpmn tarefa] (t1)  at (x,y) {Texto};    tarefa
%      \bpmnpasso{t2}{x,y}{3}{Texto}                 tarefa que e o passo 3
%      \bpmngateway{g1}{x,y}                         gateway exclusivo (X)
%      \draw[bpmn fluxo] (a) -- (b);                 fluxo de sequencia
%      \node[bpmn rotulo] at (...) {Sim};            rotulo de fluxo
% =============================================================================
\tikzset{
    bpmn raia/.style={fill=guiapapel,draw=guiaborda,line width=0.6pt},
    bpmn raiatopo/.style={fill=guiagrafite,draw=guiagrafite,text=white,
        font=\guiahead\bfseries\fontsize{9.5}{11}\selectfont},
    bpmn tarefa/.style={draw=guiatinta,line width=0.9pt,fill=white,
        rounded corners=5pt,align=center,text width=3.6cm,inner sep=3.5pt,
        minimum height=0.86cm,
        font=\guiahead\fontsize{8.6}{10.2}\selectfont,text=guiatinta},
    bpmn inicio/.style={circle,draw=guiatinta,line width=1.1pt,fill=white,
        minimum size=0.62cm,inner sep=0pt},
    bpmn fim/.style={circle,draw=guiatinta,line width=2.6pt,fill=white,
        minimum size=0.62cm,inner sep=0pt},
    bpmn gateway/.style={diamond,draw=guiatinta,line width=0.9pt,fill=white,
        minimum size=0.9cm,inner sep=0pt},
    bpmn fluxo/.style={-{Stealth[length=5.5pt,width=4.5pt]},draw=guiatinta,
        line width=0.8pt,rounded corners=4pt},
    bpmn rotulo/.style={font=\guiahead\fontsize{8}{9.5}\selectfont,
        text=guiacinza,inner sep=1.5pt,align=left},
}
\newcommand{\bpmnraia}[4]{%
    \fill[bpmn raia] (#1,0) rectangle ({#1+#2},{-#3});
    \draw[guiaborda,line width=0.6pt] (#1,0) rectangle ({#1+#2},{-#3});
    \node[bpmn raiatopo,minimum width=#2 cm,minimum height=0.62cm,anchor=north west,
          inner sep=0pt] at (#1,0) {#4};
}
\newcommand{\bpmngateway}[2]{%
    \node[bpmn gateway] (#1) at (#2) {};
    \draw[guiatinta,line width=1.3pt,line cap=round]
        ($(#1.center)+(-0.12,-0.12)$) -- ($(#1.center)+(0.12,0.12)$)
        ($(#1.center)+(-0.12,0.12)$) -- ($(#1.center)+(0.12,-0.12)$);
}
\newcommand{\bpmnpasso}[4]{%
    \node[bpmn tarefa,draw=guiavermelho,line width=1.1pt] (#1) at (#2) {#4};
    \node[guia marcador] at (#1.north west) {\hyperref[passo:#3]{\color{white}#3}};
}

