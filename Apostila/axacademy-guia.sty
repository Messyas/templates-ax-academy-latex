% O topo e mais baixo que o do manual (130 pt): aqui o mapa da parte lista
% tambem os passos, e com o topo do manual a Parte II passava para a pagina
% seguinte, sem fundo. Com 3 capitulos e 11 secoes (o guia do Hanaro), 60 pt
% ainda jogava as duas ultimas linhas numa pagina a mais; 28 pt, menos ar
% depois do filete e o mapa mais justo cabem.
\titleformat{\part}[display]
    {\thispagestyle{empty}\vspace*{28pt}\raggedright}
    {{\guiahead\fontsize{130}{130}\selectfont\bfseries\color{guiavermelho!18}\thepart}}
    {-36pt}
    {\guiahead\fontsize{34}{40}\selectfont\bfseries\color{guiatinta}}
    [\vspace{12pt}{\color{guiavermelho}\rule{0.42\textwidth}{3bp}}%
     \vspace{16pt}%
     {\normalfont\fontsize{11}{16}\selectfont\color{guiacinza}%
      \printcontents{l}{0}{\setcounter{tocdepth}{1}}}]
\titlespacing*{\part}{0pt}{0pt}{0pt}

% O fundo e registrado ANTES do titulo; o asterisco faz valer so para a
% proxima pagina. A ancora e \AtPageLowerLeft porque o tikzpicture da placa
% tem o baseline na base: ancorado pelo topo, sairia inteiro para fora.
\newcommand{\guiafundodeparte}{%
    \AddToShipoutPictureBG*{\AtPageLowerLeft{\guiaplacaparte}}%
}

