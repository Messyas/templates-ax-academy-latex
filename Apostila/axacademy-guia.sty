% --- Marca do sistema: icone + nome --------------------------------------------
% A medida e a ALTURA do icone. O nome sai na Headline em negrito, com corpo
% proporcional ao icone e centrado na vertical em relacao a ele.
% Uso: \guiamarca{62bp}
\newlength{\guiaHicone}
\newcommand{\guiamarca}[1]{%
    \setlength{\guiaHicone}{#1}%
    \mbox{%
        \ifdefempty{\guiavalmarcaicone}{}{%
            \includegraphics[height=\guiaHicone]{\guiavalmarcaicone}%
            \hspace{0.26\guiaHicone}}%
        \ifdefempty{\guiavalmarcatexto}{%
            \raisebox{0.27\guiaHicone}{%
                \fontsize{0.62\guiaHicone}{0.62\guiaHicone}\selectfont
                \guiahead\bfseries\color{guiatinta}\guiavalsistema}%
        }{%
            % Sem icone ao lado, o logotipo nao sobe: a altura dele e a da marca.
            \ifdefempty{\guiavalmarcaicone}{%
                \includegraphics[height=0.76\guiaHicone]{\guiavalmarcatexto}%
            }{%
                \raisebox{0.12\guiaHicone}{%
                    \includegraphics[height=0.76\guiaHicone]{\guiavalmarcatexto}}%
            }%
        }%
    }%
}

% --- Marcas institucionais: AX Academy e IFAM -----------------------------------
% A altura passada e a do logotipo da AX; o do IFAM sai com 1,15 dela, para os
% dois terem o mesmo peso visual (o da AX tem a tagline embaixo).
% A medida vai para um comprimento antes de ser multiplicada: escrever
% `1.15#1' com #1 = 16pt daria 1.1516pt, e nao 1,15 x 16 pt.
\newlength{\guiaHinst}
\newcommand{\guiamarcasinst}[1][16pt]{%
    \setlength{\guiaHinst}{#1}%
    \mbox{\raisebox{-0.12\height}{\includegraphics[height=\guiaHinst]{logo-ax}}%
    \hspace{1.1\guiaHinst}%
    {\color{guiaborda}\rule[-0.3\guiaHinst]{0.6pt}{1.45\guiaHinst}}%
    \hspace{1.1\guiaHinst}%
    \raisebox{-0.2\height}{\includegraphics[height=1.15\guiaHinst]{logo-ifam}}}%
}

