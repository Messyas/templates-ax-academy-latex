# ==============================================================================
# .gitignore - Regras de exclusão para o repositório templates-ax-academy-latex
# ==============================================================================

# --- Python e uv ---
.venv/
.uv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage

# --- Saídas de compilação (PDFs finais centralizados) ---
dist/
build/
out/
_build/

# PDFs compilados intermediários nas pastas dos templates (saídas oficiais vão para dist/)
Apostila/guia-rapido.pdf
Flyer/guia-flyer.pdf
One-page/onepage-lg.pdf

# --- Arquivos auxiliares e intermediários gerados pelo LaTeX ---
*.aux
*.log
*.out
*.toc
*.ptc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.lot
*.lof
*.idx
*.ilg
*.ind
*.loa
*.xdv
*.upa
*.upb
*.dvi

# --- Variáveis de ambiente, credenciais e segredos locais ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.credentials

# --- Editores, IDEs e ferramentas ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak

# --- Sistema Operacional e temporários ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
temp_installer/
*.tmp
