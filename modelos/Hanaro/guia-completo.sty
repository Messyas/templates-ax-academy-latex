% Recortes e chamadas numeradas: aplicados somente depois dos capítulos originais.
\tikzset{guia marcador/.append style={minimum size=13pt,line width=0.9pt,
 font=\guiahead\bfseries\fontsize{7.5}{7.5}\selectfont}}
\newcommand{\guiaincluircaptura}[1]{%
 \ifcsname guiatela@trim@#1\endcsname
  \edef\guia@imageopts{width=\the\guiacolimagem,trim={\csname guiatela@trim@#1\endcsname},clip}%
  \expandafter\includegraphics\expandafter[\guia@imageopts]{#1}%
 \else\includegraphics[width=\guiacolimagem]{#1}\fi}
\renewcommand{\guiatela}[2]{%
 \begin{tikzpicture}
  \node[anchor=south west,inner sep=0pt] (tela) at (0,0) {\guiaincluircaptura{#2}};
  \draw[overlay,guiaborda,line width=0.7pt] (tela.south west) rectangle (tela.north east);
  \ifblank{#1}{}{%
   \begin{scope}[overlay,x={(tela.south east)},y={(tela.north west)}]
    \foreach \tx/\ty/\lx/\ly [count=\mn] in {#1}{%
     \draw[white,line width=1.8pt] (\lx,{1-\ly}) -- (\tx,{1-\ty});
     \draw[guiavermelho,line width=0.7pt] (\lx,{1-\ly}) -- (\tx,{1-\ty});
     \node[guia marcador] at (\lx,{1-\ly}) {\mn};
    }%
   \end{scope}%
  }%
 \end{tikzpicture}}

