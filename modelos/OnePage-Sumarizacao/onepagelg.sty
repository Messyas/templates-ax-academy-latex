% =============================================================
% onepagelg.sty — motor de layout do OnePage LG (Before / After / Result)
%
%   Porte do ONEPAGE-KR.pptx (padrao corporativo LGE, "AI Deep Dive").
%   TODO O CONTEUDO vive em onepage-lg.tex. Aqui ficam pagina, cores, fontes
%   e posicoes — normalmente nao se mexe.
%
%   A pagina inteira e um unico canvas TikZ em centimetros, com a origem no
%   canto superior esquerdo do papel e o eixo Y crescendo para baixo
%   (x=1cm, y=-1cm). As coordenadas sao as mesmas do slide original.
%
%   As listas (pontos, melhorias, afirmacoes, efeitos) se empilham sozinhas:
%   a altura de cada item e medida e o cursor anda. Acrescentar ou remover
%   um item nao exige recalcular coordenada nenhuma.
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{onepagelg}[2026/09/21 OnePage LG - Before/After/Result]

\RequirePackage[paperwidth=33.87cm,paperheight=19.05cm,margin=0pt]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{fontawesome5}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta}

% ---------- FONTES (LG EI, carregadas de ../../fonts/, ../fonts/ ou fonts/) ----------
\defaultfontfeatures{Ligatures=TeX}
\IfFileExists{../../fonts/LGEITextTTF-Regular.ttf}{%
  \setmainfont{LGEITextTTF-Regular}[Path=../../fonts/, Extension=.ttf, BoldFont=LGEITextTTF-Bold]
  \newfontfamily\lgheadreg{LGEIHeadlineTTF-Regular}[Path=../../fonts/, Extension=.ttf]
}{%
  \IfFileExists{../fonts/LGEITextTTF-Regular.ttf}{%
    \setmainfont{LGEITextTTF-Regular}[Path=../fonts/, Extension=.ttf, BoldFont=LGEITextTTF-Bold]
    \newfontfamily\lgheadreg{LGEIHeadlineTTF-Regular}[Path=../fonts/, Extension=.ttf]
  }{%
    \IfFileExists{fonts/LGEITextTTF-Regular.ttf}{%
      \setmainfont{LGEITextTTF-Regular}[Path=fonts/, Extension=.ttf, BoldFont=LGEITextTTF-Bold]
      \newfontfamily\lgheadreg{LGEIHeadlineTTF-Regular}[Path=fonts/, Extension=.ttf]
    }{%
      \PackageWarning{onepagelg}{Pasta de fontes nao encontrada (procurado em ../../fonts/, ../fonts/ e fonts/); usando a fonte instalada no sistema.}%
      \setmainfont{LG EI Text}[BoldFont=* Bold]
      \newfontfamily\lgheadreg{LG EI Headline}
    }%
  }%
}

% ---------- PALETA (as cores do PPTX da LGE) ----------
\definecolor{lgink}{RGB}{0,0,0}
\definecolor{lgred}{RGB}{192,0,0}        % C00000 — numeros de impacto e seta de ganho
\definecolor{lgteal}{RGB}{8,191,165}     % nucleo AI CORE e raios do diagrama
\definecolor{lggray}{RGB}{166,166,166}   % A6A6A6 — barra "After", tarjas numeradas
\definecolor{lggraysoft}{RGB}{217,217,217} % D9D9D9 — barra "Before"
\definecolor{lgline}{RGB}{191,191,191}   % BFBFBF — bordas e abas laterais
\definecolor{lggreen}{RGB}{146,208,80}   % 92D050 — contorno da barra "After"
\definecolor{lgmint}{RGB}{214,250,227}   % D6FAE3 — caixa de resultado
\definecolor{lgmuted}{RGB}{128,128,128}

\pagestyle{empty}
\setlength{\parindent}{0pt}
% slide nao hifeniza: as quebras seguem as palavras, como no PPTX
\hyphenpenalty=10000 \exhyphenpenalty=10000 \tolerance=9999 \emergencystretch=3em

% ---------- atalhos internos ----------
\newcommand{\pt}[2]{\fontsize{#1}{#2}\selectfont\ignorespaces}
\newcommand{\lg@quadrado}{\raisebox{-0.02em}{\tikz{\draw[lgline, line width=1.2pt]
  (0,0) rectangle (0.32,0.32);}}\hspace{0.16cm}}
\newcommand{\lg@bul}{\raisebox{0.15ex}{\scriptsize\textbullet}}
\newcommand{\lg@tick}{\raisebox{0.05ex}{\footnotesize$\checkmark$}}

% ---------- listas: acumulam conforme sao chamadas, desenham em \onepage ----------
\newcommand{\lg@novalista}[1]{\expandafter\gdef\csname lg@l@#1\endcsname{}}
\newcommand{\lg@empilha}[2]{\expandafter\g@addto@macro\csname lg@l@#1\endcsname{#2}}
% guarda o conteudo de um macro (usado quando a altura ja foi medida)
\newcommand{\lg@guarda}[2]{\expandafter\lg@guardax\expandafter{#2}{#1}}
\newcommand{\lg@guardax}[2]{\lg@empilha{#2}{#1}}
\newcommand{\lg@desenha}[1]{\csname lg@l@#1\endcsname}

% ---------- medicao: devolve em \lg@hcm a altura (cm) do texto ----------
%   So funciona fora de um tikzpicture — por isso os itens que dependem da
%   altura sao medidos na hora em que o documento os declara, nao na hora de
%   desenhar. E por isso que o conteudo fica depois de \begin{document}.
\newsavebox{\lg@box}
\newlength{\lg@len}
\newcommand{\lg@mede}[2]{%
  \sbox\lg@box{\parbox{#1cm}{\raggedright #2}}%
  \lg@len=\dimexpr\ht\lg@box+\dp\lg@box\relax
  \edef\lg@lenpt{\strip@pt\lg@len}%
  \pgfmathsetmacro{\lg@hcm}{\lg@lenpt/28.45276}}

% =============================================================
%  API — os comandos que onepage-lg.tex usa
% =============================================================

% ---------- cabecalho e rodape ----------
\newcommand{\avisotopo}[1]{\def\lg@avisotopo{#1}}
\newcommand{\titulo}[1]{\def\lg@titulo{#1}}
\newcommand{\subtitulo}[1]{\def\lg@subtitulo{#1}}
\newcommand{\colunas}[3]{\def\lg@colA{#1}\def\lg@colB{#2}\def\lg@colC{#3}}
\newcommand{\rodape}[2]{\def\lg@rodapeC{#1}\def\lg@rodapeD{#2}}
\avisotopo{}\titulo{}\subtitulo{}\colunas{Before}{After}{Result}\rodape{}{}

% ---------- coluna 1: Before ----------
\newcommand{\tituloantes}[1]{\def\lg@tituloantes{#1}}
\newcommand{\textoantes}[1]{\def\lg@textoantes{#1}}
\newcommand{\alerta}[2]{\def\lg@alertaimg{#1}\def\lg@alertatxt{#2}}
\newcommand{\tituloquadro}[1]{\def\lg@tituloquadro{#1}}
\newcommand{\fluxo}[2]{\def\lg@fluxoA{#1}\def\lg@fluxoB{#2}}
\tituloantes{}\textoantes{}\alerta{}{}\tituloquadro{}\fluxo{}{}

\lg@novalista{ponto}
% \ponto[altura do icone em cm]{arquivo do icone}{texto}
\newcommand{\ponto}[3][1.15]{\lg@empilha{ponto}{\lg@ponto{#1}{#2}{#3}}}

\lg@novalista{destaque}
% \destaque[largura do icone em cm]{arquivo do icone}{texto}
\newcommand{\destaque}[3][1.08]{\lg@empilha{destaque}{\lg@destaque{#1}{#2}{#3}}}

% ---------- coluna 2: After ----------
\newcommand{\titulodepois}[1]{\def\lg@titulodepois{#1}}
\newcommand{\textodepois}[1]{\def\lg@textodepois{#1}}
\newcommand{\abas}[2]{\def\lg@abaA{#1}\def\lg@abaB{#2}}
\newcommand{\ilustracoes}[3]{\def\lg@ilusA{#1}\def\lg@ilusB{#2}\def\lg@ilusC{#3}}
\titulodepois{}\textodepois{}\abas{}{}\ilustracoes{}{}{}

\lg@novalista{melhoria}
% \melhoria{texto}
\newcommand{\melhoria}[1]{%
  \lg@mede{10.9}{\pt{10}{13}\bfseries #1}%
  \edef\lg@tmp{\noexpand\lg@melhoria{\lg@hcm}{\unexpanded{#1}}}%
  \lg@guarda{melhoria}{\lg@tmp}}

\lg@novalista{afirmacao}
% \afirmacao{texto}
\newcommand{\afirmacao}[1]{%
  \lg@mede{5.05}{\pt{8}{11}\bfseries #1}%
  \edef\lg@tmp{\noexpand\lg@afirmacao{\lg@hcm}{\unexpanded{#1}}}%
  \lg@guarda{afirmacao}{\lg@tmp}}

\lg@novalista{area}
% \area{angulo em graus}{rotulo} — o rotulo se posiciona sozinho pelo angulo
\newcommand{\area}[2]{\lg@empilha{area}{\lg@area{#1}{#2}}}

% ---------- coluna 3: Result ----------
\newcommand{\tituloresultado}[1]{\def\lg@tituloresultado{#1}}
\newcommand{\graficoeixo}[1]{\def\lg@grafeixo{#1}}
\newcommand{\graficonota}[1]{\def\lg@grafnota{#1}}
\newcommand{\impacto}[3]{\def\lg@impimg{#1}\def\lg@implabel{#2}\def\lg@impval{#3}}
\newcommand{\resultado}[2]{\def\lg@reslabel{#1}\def\lg@resval{#2}}
\tituloresultado{}\graficoeixo{}\graficonota{}\impacto{}{}{}\resultado{}{}

\lg@novalista{efeito}
% \efeito{texto} — a tarja numera sozinha e cresce conforme o texto
\newcommand{\efeito}[1]{%
  \lg@mede{5.8}{\pt{10}{12.5}\bfseries #1}%
  \edef\lg@tmp{\noexpand\lg@efeito{\lg@hcm}{\unexpanded{#1}}}%
  \lg@guarda{efeito}{\lg@tmp}}

\lg@novalista{barra}
% \graficobarra{categoria}{rotulo do valor}{altura em cm}
\newcommand{\graficobarra}[3]{\lg@empilha{barra}{\lg@barra{#1}{#2}{#3}}}

% =============================================================
%  DESENHO — daqui para baixo e geometria
% =============================================================

% ---------- coluna 1: item com icone ----------
\newcommand{\lgpontoinicio}{6.89}   % centro da 1a linha
\newcommand{\lgpontopasso}{1.60}    % distancia entre linhas
\newcommand{\lg@ponto}[3]{%
  \node[anchor=center, inner sep=0pt] at (2.90,\lg@y) {\includegraphics[height=#1cm]{img/#2}};
  \node[anchor=west, inner sep=0pt] at (3.56,\lg@y) {\pt{10}{13}\lg@bul};
  \node[anchor=west, text width=7.45cm, align=left, inner sep=0pt] at (4.06,\lg@y)
    {\pt{10}{13}\bfseries #3};
  \pgfmathsetmacro{\lg@y}{\lg@y+\lgpontopasso}}

% ---------- coluna 1: numero de impacto dentro do quadro ----------
\newcommand{\lgdestaqueinicio}{14.92}
\newcommand{\lgdestaquepasso}{1.32}
\newcommand{\lg@destaque}[3]{%
  \node[anchor=center, inner sep=0pt] at (2.98,\lg@y) {\includegraphics[width=#1cm]{img/#2}};
  \node[anchor=west, text width=7.4cm, align=left, inner sep=0pt] at (3.73,\lg@y)
    {\pt{12}{15}\bfseries\color{lgred}#3};
  \pgfmathsetmacro{\lg@y}{\lg@y+\lgdestaquepasso}}

% ---------- coluna 2: marcador simples ----------
\newcommand{\lgmelhoriainicio}{6.92}
\newcommand{\lg@melhoria}[2]{%
  \node[anchor=west, inner sep=0pt] at (12.69,\lg@y) {\pt{10}{13}\lg@bul};
  \node[anchor=west, text width=10.9cm, align=left, inner sep=0pt] at (13.19,\lg@y)
    {\pt{10}{13}\bfseries #2};
  \pgfmathsetmacro{\lg@y}{\lg@y+max(0.70,#1+0.26)}}

% ---------- coluna 2: afirmacao com visto ----------
\newcommand{\lgafirmacaoinicio}{9.98}
\newcommand{\lg@afirmacao}[2]{%
  \node[anchor=west, inner sep=0pt] at (18.74,\lg@y) {\pt{8}{11}\lg@tick};
  \node[anchor=west, text width=5.05cm, align=left, inner sep=0pt] at (19.14,\lg@y)
    {\pt{8}{11}\bfseries #2};
  \pgfmathsetmacro{\lg@y}{\lg@y+#1+0.44}}

% ---------- coluna 2: raio do diagrama AI CORE ----------
\newcommand{\lg@area}[2]{%
