% ---------- coluna 3: tarja numerada ----------
\newcommand{\lgefeitoinicio}{4.87}
\newcommand{\lgefeitovao}{0.40}
\newcommand{\lg@efeito}[2]{%
  \pgfmathsetmacro{\lg@h}{max(0.67,#1+0.23)}%
  \pgfmathtruncatemacro{\lg@n}{\lg@n+1}%
  \draw[lgline, line width=0.5pt] (25.95,\lg@y) rectangle ++(6.73,\lg@h);
  \fill[lggray] (25.95,\lg@y) rectangle ++(0.71,\lg@h);
  \node[anchor=center, text=white] at ({26.305},{\lg@y+\lg@h/2}) {\pt{10}{11}\bfseries \lg@n};
  \node[anchor=west, text width=5.8cm, align=left, inner sep=0pt] at ({26.90},{\lg@y+\lg@h/2})
    {\pt{10}{12.5}\bfseries #2};
  \pgfmathsetmacro{\lg@y}{\lg@y+\lg@h+\lgefeitovao}}

% ---------- coluna 3: barra do grafico ----------
\newcommand{\lgbarrabase}{12.39}    % linha de base
\newcommand{\lgbarrainicio}{27.135} % centro da 1a barra
\newcommand{\lgbarrapasso}{1.87}    % distancia entre barras
\newcommand{\lg@barra}[3]{%
  \pgfmathtruncatemacro{\lg@n}{\lg@n+1}%
  \pgfmathsetmacro{\lg@cx}{\lgbarrainicio+(\lg@n-1)*\lgbarrapasso}%
  \pgfmathsetmacro{\lg@topo}{\lgbarrabase-#3}%
  \ifnum\lg@n=1
    \fill[lggraysoft] ({\lg@cx-0.585},\lgbarrabase) rectangle ({\lg@cx+0.585},\lg@topo);
    \node[anchor=south, inner sep=1.5pt, text=lgink] at (\lg@cx,{\lg@topo-0.03}) {\pt{8}{9}#2};
    \xdef\lg@barumx{\lg@cx}\xdef\lg@barumy{\lg@topo}%
  \else
    \fill[lggray] ({\lg@cx-0.585},\lgbarrabase) rectangle ({\lg@cx+0.585},\lg@topo);
    \draw[lggreen, line width=1.2pt] ({\lg@cx-0.585},\lgbarrabase)
      -- ({\lg@cx-0.585},\lg@topo) -- ({\lg@cx+0.585},\lg@topo) -- ({\lg@cx+0.585},\lgbarrabase);
    \node[anchor=south, inner sep=1.5pt, text=lgink] at (\lg@cx,{\lg@topo-0.03}) {\pt{8}{9}\bfseries #2};
  \fi
  \node[anchor=north, inner sep=3pt, text=lgink] at (\lg@cx,{\lgbarrabase+0.05}) {\pt{9}{10}#1};
  \xdef\lg@barfimx{\lg@cx}\xdef\lg@barfimy{\lg@topo}}

\newcommand{\lg@grafico}{%
  \pgfmathtruncatemacro{\lg@n}{0}%
  \lg@desenha{barra}%
  % eixo, seta de ganho (vermelha) e legendas
  \draw[lgline, line width=0.5pt] ({\lg@barumx-1.15},{\lgbarrabase+0.02})
    -- ({\lg@barfimx+1.15},{\lgbarrabase+0.02});
  \draw[lgred, line width=1.0pt, -{Stealth[length=3.4mm, width=2.8mm]}]
    (\lg@barumx,\lg@barumy) -- ({\lg@barfimx-0.58},\lg@barfimy);
  \node[anchor=north west, inner sep=0pt, text=lgmuted] at (26.26,9.34) {\pt{7}{8}\lg@grafeixo};
  \node[anchor=north west, inner sep=0pt, text=lgmuted] at (29.91,10.30)
    {\pt{8}{9}\lg@bul\ \lg@grafnota};}

